    {
      "id": 17,
      "type": "row",
      "title": "Consultas (pg_stat_statements)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 18,
      "type": "table",
      "title": "Consultas que mais consumiram tempo no intervalo",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(topk(20, sum by (queryid) (increase(pg_stat_statements_seconds_total{datname=\"cmj\"}[$__range])))) * on (queryid) group_left (query) max by (queryid, query) (pg_stat_statements_query_id)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (queryid) (increase(pg_stat_statements_calls_total{datname=\"cmj\"}[$__range])) and on (queryid) topk(20, sum by (queryid) (increase(pg_stat_statements_seconds_total{datname=\"cmj\"}[$__range])))) * on (queryid) group_left (query) max by (queryid, query) (pg_stat_statements_query_id)",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "((sum by (queryid) (increase(pg_stat_statements_seconds_total{datname=\"cmj\"}[$__range])) / sum by (queryid) (increase(pg_stat_statements_calls_total{datname=\"cmj\"}[$__range]))) and on (queryid) topk(20, sum by (queryid) (increase(pg_stat_statements_seconds_total{datname=\"cmj\"}[$__range])))) * on (queryid) group_left (query) max by (queryid, query) (pg_stat_statements_query_id)",
          "legendFormat": "",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (queryid) (increase(pg_stat_statements_rows_total{datname=\"cmj\"}[$__range])) and on (queryid) topk(20, sum by (queryid) (increase(pg_stat_statements_seconds_total{datname=\"cmj\"}[$__range])))) * on (queryid) group_left (query) max by (queryid, query) (pg_stat_statements_query_id)",
          "legendFormat": "",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Tempo total"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Tempo médio"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Chamadas"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Linhas"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Consulta"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 900
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Tempo total",
            "desc": true
          }
        ]
      },
      "description": "Top 20 por tempo de execução somado no intervalo do dashboard. O texto vem normalizado pelo pg_stat_statements (constantes viram $1) e cortado em 300 caracteres. O exporter só envia as 100 consultas de maior tempo acumulado.",
      "transformations": [
        {
          "id": "merge",
          "options": {}
