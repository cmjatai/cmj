          "expr": "sum(increase(pg_stat_database_blks_hit{datname=\"cmj\"}[$__range])) / (sum(increase(pg_stat_database_blks_hit{datname=\"cmj\"}[$__range])) + sum(increase(pg_stat_database_blks_read{datname=\"cmj\"}[$__range])))",
          "legendFormat": "",
