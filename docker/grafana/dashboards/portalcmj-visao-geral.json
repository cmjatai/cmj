          "expr": "sum by (type) (rate(django_http_exceptions_total_by_type_total[$__rate_interval]))",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Duração da coleta do /metrics",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
