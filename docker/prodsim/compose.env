# Variáveis do compose da produção simulada (passadas com --env-file pelos
# scripts desta pasta). Só valores locais: nada aqui serve para a produção.
APP_NETWORK_NAME=prodsim-net

PRODSIM_HTTP_PORT=8088
PRODSIM_HTTPS_PORT=8443
PRODSIM_SOLR_HEAP=1g
# PRODSIM_MEDIA_SRC=/caminho/para/uma/copia/de/midia

MONITORING_RESTART=no
MONITORING_BIND_IP=127.0.0.1
GRAFANA_PORT=3001
GRAFANA_ROOT_URL=http://127.0.0.1:3001
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_PORT=9091
PROMETHEUS_RETENTION_TIME=7d
PROMETHEUS_RETENTION_SIZE=2GB
PG_EXPORTER_DSN=postgresql://cmj_dt1:cmj_dt1@cmjpostgres18:5432/cmj?sslmode=disable
SOLR_BASIC_AUTH=solr:solr

# Alertas vão para o container alerta-receptor, nunca para fora
GRAFANA_CONTATO=webhook-local
ALERTA_RECEPTOR_HOST=alerta-receptor
