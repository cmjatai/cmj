# .env da aplicação na produção simulada. O up.sh copia este arquivo para
# docker/prodsim/cmj.env (ignorado pelo git) e gera o SECRET_KEY.
# Não coloque chave de serviço externo (Telegram, YouTube, S3, Gemini...):
# a simulação não deve falar com eles.
DEBUG=False
SECRET_KEY=__GERADO_PELO_UP_SH__
DATABASE_URL_PRD=postgresql://cmj_dt1:cmj_dt1@cmjdb18:5432/cmj
REDIS_HOST=cmjredis
REDIS_PORT=6379
BASE_URL=https://localhost:8443
# E-mail não sai da simulação
EMAIL_HOST=localhost
EMAIL_HOST_PASSWORD=
