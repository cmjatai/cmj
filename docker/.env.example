# Copie para docker/.env no servidor (o arquivo real é ignorado pelo git).
# O docker compose lê este arquivo sozinho quando roda os composes da pasta docker/.
# Documentação: docs/backend/monitoramento.md

# IP onde o Grafana é publicado. Padrão: 127.0.0.1 (só por túnel SSH).
# Na produção, o IP da rede interna do servidor, nunca um IP público.
MONITORING_BIND_IP=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ROOT_URL=http://127.0.0.1:3000
GRAFANA_ADMIN_PASSWORD=troque-esta-senha

# Prometheus: sempre em 127.0.0.1.
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=10GB

# Usuário do Postgres só com pg_monitor.
PG_EXPORTER_DSN=postgresql://monitor:troque-esta-senha@cmjpostgres18:5432/cmj?sslmode=disable

# Usuário:senha do Solr (o mesmo do SOLR_URL dos containers da aplicação).
SOLR_BASIC_AUTH=solr:solr
